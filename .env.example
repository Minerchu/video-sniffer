# 单个文件下载上限（MB）
MAX_DOWNLOAD_MB=2048

# 单次解析最多返回多少个媒体条目
MAX_MEDIA_ITEMS=40

# 单次解析总超时（秒）
SNIFF_TIMEOUT_SECONDS=45

# 下载任务临时文件保留时间（秒）
JOB_TTL_SECONDS=7200

# 是否启用 Playwright 手机浏览器网络监听
ENABLE_PLAYWRIGHT=1

# 仅在本地开发调试时设为 1，生产环境必须保持 0
ALLOW_PRIVATE_NETWORK=0

# 可选：指定 ffmpeg 可执行文件路径
# FFMPEG_PATH=C:\path\to\ffmpeg.exe